# ─────────────────────────────────────────────────────────────────────────────
# Playwright E2E test environment template.
#
# Copy this file to `.env.test` and fill in the values from a DEDICATED TEST
# Supabase project. The real `.env.test` is gitignored (matched by `.env*` in
# .gitignore) and MUST NEVER be committed — it holds a service_role key.
#
# CRITICAL:
#   - `.env.test` MUST point at the dedicated TEST Supabase project, NEVER
#     production. Tests seed/mutate data via the service_role key.
#   - The `supabase db push --db-url <conn>` migration step uses the DIRECT
#     connection (port 5432), NOT the app's transaction pooler (port 6543).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — TEST project (Settings → API). Use the test project ref/keys only.
NEXT_PUBLIC_SUPABASE_URL=https://<test-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<test-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<test-service-role-key>

# Admin password forwarded to the app process under test.
ADMIN_PASSWORD=test
